# ============================================================
# ORCA — Ocean Risk & Catch Advisor
# Git ignore rules
# ============================================================

# ------------------------------------------------------------
# Environment / secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example

# Never commit credentials, API keys, passwords, or local secrets
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
wheels/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Type checking / lint caches
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# ------------------------------------------------------------
# Node / Next.js frontend
# ------------------------------------------------------------
node_modules/
.next/
out/
dist/
build/
.turbo/
.vercel/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files generated by frontend tooling
.env.local
.env.development.local
.env.test.local
.env.production.local

# ------------------------------------------------------------
# IDE / editors
# ------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

.idea/
*.iml

# Vim
*.swp
*.swo

# Visual Studio
.vs/

# ------------------------------------------------------------
# OS files
# ------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ------------------------------------------------------------
# Logs / temporary files
# ------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.cache

# ------------------------------------------------------------
# Local databases
# ------------------------------------------------------------
*.sqlite
*.sqlite3
*.db

# ------------------------------------------------------------
# Runtime / local application data
# ------------------------------------------------------------
runtime/
local_data/
.cache/

# ------------------------------------------------------------
# Geospatial generated/intermediate files
# ------------------------------------------------------------

# Keep the project's source geospatial datasets in Git only if
# the team intentionally wants them versioned.
#
# Large/raw/generated geospatial data should normally be kept out
# of Git and downloaded/imported separately.
#
# Uncomment these if the team decides NOT to commit the downloaded
# World EEZ / raw geospatial datasets:
#
# data/geospatial/raw/
# data/geospatial/processed/
# data/geospatial/*.gpkg
# data/geospatial/*.shp
# data/geospatial/*.shx
# data/geospatial/*.dbf
# data/geospatial/*.prj
# data/geospatial/*.cpg
# data/geospatial/*.geojson
#
# Do not ignore the LICENSE files.

# ------------------------------------------------------------
# Generated exports / downloaded datasets
# ------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.7z

# Large data formats — uncomment if these are generated/downloaded
# and should not be committed:
#
# *.nc
# *.nc4
# *.h5
# *.hdf5
# *.tif
# *.tiff
# *.parquet

# ------------------------------------------------------------
# Local Copernicus / tool caches
# ------------------------------------------------------------
.copernicus/
copernicus_cache/
*.nc.tmp

# ------------------------------------------------------------
# Local development / debug artifacts
# ------------------------------------------------------------
debug/
debug_*.json
response_*.json
test_output/
*.pid

# ------------------------------------------------------------
# Generated frontend artifacts
# ------------------------------------------------------------
*.tsbuildinfo

# ------------------------------------------------------------
# Miscellaneous
# ------------------------------------------------------------
.DS_Store
*.orig
*.rej
